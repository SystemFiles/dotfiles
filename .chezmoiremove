# -*-mode:bash-*- vim:ft=chezmoiremove

# ~/.local/share/chezmoi/.chezmoiremove
# =============================================================================
# If a file called .chezmoiremove exists in the source state then it is
# interpreted as a list of targets to remove. .chezmoiremove is interpreted
# as a template.
#
# Reference: https://www.chezmoi.io/docs/reference/#chezmoiremove

.gitcookies
.gitignore
.worktreeinclude

# AI-native overhaul (Spec 01): remove stale vendor artifacts left over from the
# pre-overhaul duplicated-content layout. These were previously chezmoi-managed
# and are now gone from the source. Excluded on purpose: the managed symlinks
# (.claude/CLAUDE.md, .codex/AGENTS.md), .codex/config.toml (intentionally left
# in place), and any */skills dir owned by the skills CLI.
#
# NOTE: obsolete ~/.agents/skills/{create_plan,iterate_plan,create_handoff,
# research_codebase} are NOT listed here: .chezmoiremove cannot remove paths
# matched by .chezmoiignore (`.agents/skills/**`). They are cleaned up once by
# .chezmoiscripts/run_once_before_01-remove-stale-agent-skills.sh.tmpl instead.
.claude/agents
.claude/commands
.claude/settings.json
.claude/statusline-simple.sh
.cursor/agents
.cursor/commands
.cursor/rules
.codex/prompts
.codex/rules
.codex/README.md
