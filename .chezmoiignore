# -*-mode:gitignore-*- vim:ft=gitignore

# ~/.local/share/chezmoi/.chezmoiignore
# =============================================================================
# If a file called .chezmoiignore exists in the source state then it is
# interpreted as a set of patterns to ignore. Patterns are matched using
# doublestar.Match and match against the target path, not the source path.
#
# Reference: https://www.chezmoi.io/docs/reference/#chezmoiignore

*.tar.gz
AGENTS.md
LICENSE.md
README.md
Makefile
*.deb
*.tar.gz
install.sh

# Repository documentation (specs, AI config notes) — never deployed to ~/
docs
docs/**

# Skills registry — read at render time, never deployed to ~/
skills-registry.txt

# Claude Code runtime files (exclude from chezmoi management)
.claude/commands/*.bak
.claude/debug/
.claude/file-history/
.claude/history.jsonl
.claude/ide/
.claude/plans/
.claude/plugins/
.claude/projects/
.claude/session-env/
.claude/shell-snapshots/
.claude/statsig/
.claude/todos/

# AI skills are owned by the `skills` CLI (canonical at ~/.agents/skills, with
# vendor symlinks). Cede these paths so chezmoi and the CLI never conflict.
.agents/skills/**
.claude/skills/**
.cursor/skills/**
.codex/skills/**
