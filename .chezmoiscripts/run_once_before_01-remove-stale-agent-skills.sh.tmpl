#!/usr/bin/env bash
# AI-native overhaul (Spec 01): one-time removal of obsolete hand-authored skills
# that were deployed under ~/.agents/skills before the skills CLI owned that path.
#
# Why a run_once_ script instead of .chezmoiremove: .chezmoiignore matches
# `.agents/skills/**`, and chezmoi will not remove ignored targets. This runs
# exactly once per machine and only touches the four known-stale skill dirs, so
# it cannot clobber skills later installed there by the `skills` CLI.
set -euo pipefail

skills_dir="{{ .chezmoi.homeDir }}/.agents/skills"

for stale in create_plan iterate_plan create_handoff research_codebase; do
  target="${skills_dir}/${stale}"
  if [ -e "${target}" ]; then
    echo "remove-stale-agent-skills: removing ${target}"
    rm -rf "${target}"
  fi
done
