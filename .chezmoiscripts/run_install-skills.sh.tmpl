#!/usr/bin/env bash
# Registry-driven AI skills installer (Spec 01, Demoable Unit 3).
#
# Runs on every `chezmoi apply`. Reads skills-registry.txt (inlined at render
# time via chezmoi's `include`) and installs each skill with the `skills` CLI in
# symlink mode: canonical copy in ~/.agents/skills/<skill>, symlinked into each
# agent's skills dir. Resilient by design: a missing toggle or npx, or a single
# bad entry, never aborts `chezmoi apply`.
set -euo pipefail

SKILLS_ENABLED="{{ .skills_enabled }}"
if [ "${SKILLS_ENABLED}" != "true" ]; then
  echo "skills: skills_enabled is not true; skipping skill installation."
  exit 0
fi
if ! command -v npx >/dev/null 2>&1; then
  echo "skills: npx not found on PATH; skipping skill installation."
  exit 0
fi

install_entry() {
  local line="$1"
  local -a toks
  read -ra toks <<<"${line}"
  local source="${toks[0]}"
  local version="" skill="" agents="cursor,claude-code"
  local t
  for t in "${toks[@]:1}"; do
    case "${t}" in
      version=*) version="${t#version=}" ;;
      skill=*)   skill="${t#skill=}" ;;
      agents=*)  agents="${t#agents=}" ;;
      *) echo "skills: ignoring unknown token '${t}' in: ${line}" ;;
    esac
  done

  # Resolve a version pin to a /tree/<ref> URL. The `skills` CLI has no
  # --version flag. Fail loudly (skip) rather than silently install latest.
  local src="${source}"
  if [ -n "${version}" ]; then
    local owner_repo=""
    case "${source}" in
      https://github.com/*) owner_repo="$(cut -d/ -f1,2 <<<"${source#https://github.com/}")" ;;
      *://*)                owner_repo="" ;;
      */*)                  owner_repo="$(cut -d/ -f1,2 <<<"${source}")" ;;
    esac
    if [[ "${owner_repo}" == */* ]]; then
      src="https://github.com/${owner_repo}/tree/${version}"
    else
      echo "skills: cannot construct a pin for source '${source}' (version=${version}); skipping to avoid an unpinned install."
      return 0
    fi
  fi

  local -a args=("skills" "add" "${src}")
  [ -n "${skill}" ] && args+=("--skill" "${skill}")
  args+=("-g")
  local a
  local -a agent_list
  IFS=',' read -ra agent_list <<<"${agents}"
  for a in "${agent_list[@]}"; do
    [ -n "${a}" ] && args+=("-a" "${a}")
  done
  args+=("-y")

  echo "skills: npx ${args[*]}"
  npx "${args[@]}" </dev/null || echo "skills: failed entry: ${line}"
}

while IFS= read -r raw; do
  # trim leading/trailing whitespace
  line="${raw#"${raw%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [ -z "${line}" ] && continue
  [[ "${line}" == \#* ]] && continue
  install_entry "${line}"
done <<'REGISTRY_EOF'
{{ include "skills-registry.txt" }}
REGISTRY_EOF
